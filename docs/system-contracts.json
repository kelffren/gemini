{
  "schema": 1,
  "rollout": "x-foundation-p2-critical",
  "systems": [
    {
      "id": "input-locks",
      "owner": "KeloInputLocks",
      "source": "src/core/input-lock-system.js",
      "technicalDoc": "docs/systems/INPUT_LOCK_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-foundation",
      "stateOwned": ["input lock claims/tokens"],
      "stateForbidden": ["player movement state", "gameplay authority"],
      "consumes": [],
      "lifecycle": ["acquire", "release", "releaseOwner", "snapshot"],
      "failurePolicy": "fail-closed-for-lock-acquire",
      "resourceClass": "core",
      "requiredTests": ["audit:foundation"]
    },
    {
      "id": "movement",
      "owner": "KeloMovement",
      "source": "src/core/movement-system.js",
      "technicalDoc": "docs/systems/MOVEMENT_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-prediction-extension",
      "stateOwned": ["movement extension hooks/interceptors"],
      "stateForbidden": ["server-authoritative position", "UI state"],
      "consumes": ["engine-a movement physics", "KeloInput"],
      "lifecycle": ["register", "setEnabled", "unregister", "snapshot"],
      "failurePolicy": "degrade-to-base-movement",
      "resourceClass": "core",
      "requiredTests": ["audit:foundation", "recovery:movement"]
    },
    {
      "id": "camera",
      "owner": "KeloCamera",
      "source": "src/core/camera-system.js",
      "technicalDoc": "docs/systems/CAMERA_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-presentation",
      "stateOwned": ["camera target", "viewport", "zoom", "screen/world transforms"],
      "stateForbidden": ["player authoritative position", "world mutations"],
      "consumes": ["viewport", "actor presentation"],
      "lifecycle": ["configure", "update", "snapshot"],
      "failurePolicy": "degrade-to-safe-camera",
      "resourceClass": "core",
      "requiredTests": ["audit:foundation"]
    },
    {
      "id": "render-extensions",
      "owner": "KeloRender",
      "source": "src/core/render-extension-system.js",
      "technicalDoc": "docs/systems/RENDER_EXTENSION_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-presentation",
      "stateOwned": ["render hooks/interceptors"],
      "stateForbidden": ["damage", "economy", "server truth"],
      "consumes": ["legacy render orchestration"],
      "lifecycle": ["register", "setEnabled", "unregister", "snapshot"],
      "failurePolicy": "degrade-nonessential-presentation",
      "resourceClass": "core",
      "requiredTests": ["audit:foundation", "audit:performance"]
    },
    {
      "id": "simulation-extensions",
      "owner": "KeloSimulation",
      "source": "src/core/simulation-extension-system.js",
      "technicalDoc": "docs/systems/SIMULATION_EXTENSION_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-simulation-extension",
      "stateOwned": ["simulation hooks", "enabled state", "suspension claims"],
      "stateForbidden": ["server truth", "render state", "UI state"],
      "consumes": ["engine-a base simulation", "engine-c legacy bridge"],
      "lifecycle": ["before", "after", "setEnabled", "suspend", "resume", "unregister", "snapshot"],
      "failurePolicy": "fail-safe-to-base-simulation-when-not-suspended",
      "resourceClass": "core",
      "requiredTests": ["audit:foundation", "audit:performance"]
    },
    {
      "id": "performance-foundation",
      "owner": "KELO_PERFORMANCE_GOVERNOR + existing Foundation owners",
      "source": "src/systems/performance-governor.js",
      "technicalDoc": "docs/systems/PERFORMANCE_FOUNDATION.md",
      "apiVersion": 1,
      "authority": "client-performance-policy",
      "stateOwned": ["quality policy", "performance telemetry", "lifecycle hints"],
      "stateForbidden": ["gameplay outcomes", "economic state", "combat authority"],
      "consumes": ["KeloRender", "KeloSimulation", "KELO_ATLAS_CONTRACT", "KeloNetAuthority"],
      "lifecycle": ["observe", "degrade", "recover", "snapshot"],
      "failurePolicy": "fail-open-for-correction-fail-closed-for-budget-enforcement-only-when-declared",
      "resourceClass": "core",
      "requiredTests": ["audit:performance"]
    },
    {
      "id": "runtime-lifecycle",
      "owner": "KeloLifecycleSupervisor",
      "source": "src/core/lifecycle-supervisor.js",
      "technicalDoc": "docs/systems/RUNTIME_LIFECYCLE_SUPERVISOR.md",
      "apiVersion": 1,
      "authority": "client-lifecycle-metadata-only",
      "stateOwned": ["per-feature lifecycle state", "bounded lifecycle history"],
      "stateForbidden": ["feature loading authority", "gameplay state", "render state", "server truth"],
      "consumes": ["KeloModuleLoader events"],
      "lifecycle": ["idle", "loading-dependencies", "mounting", "connecting", "ready", "degraded", "error", "unmounting", "disposed"],
      "failurePolicy": "reject-illegal-transition-and-keep-current-state",
      "resourceClass": "core-light",
      "requiredTests": ["lifecycle-failure-audit", "audit:foundation"]
    },
    {
      "id": "failure-boundary",
      "owner": "KeloFailureBoundary",
      "source": "src/core/failure-boundary.js",
      "technicalDoc": "docs/systems/FAILURE_BOUNDARY.md",
      "apiVersion": 1,
      "authority": "optional-feature-retry-gate-only",
      "stateOwned": ["per-feature circuit state", "failure/success counters", "cooldown timestamps"],
      "stateForbidden": ["persistent feature selection", "feature loading authority", "gameplay state", "server truth"],
      "consumes": ["KeloModuleLoader completion events", "KELO_ASSET_REGISTRY effective gate"],
      "lifecycle": ["closed", "open", "half-open", "reset"],
      "failurePolicy": "fail-fast-only-for-repeated-optional-feature-loads",
      "resourceClass": "core-light",
      "requiredTests": ["lifecycle-failure-audit", "audit:foundation"]
    },
    {
      "id": "net-governor",
      "owner": "KeloNetAuthority",
      "source": "engine-net.js",
      "technicalDoc": "docs/systems/NET_GOVERNOR.md",
      "apiVersion": 1,
      "authority": "client-network-health-diagnostics-only",
      "stateOwned": ["PvP input-ack RTT EMA", "PvP jitter EMA", "last ack age/sample counters"],
      "stateForbidden": ["second transport", "damage", "HP", "cooldowns", "authoritative position", "MMR/RP", "match result"],
      "consumes": ["existing combat intent timestamps", "authoritative ackSequence", "KeloSimulation existing network hook"],
      "lifecycle": ["sample-on-ack", "observe", "fallback-before-first-sample", "snapshot"],
      "failurePolicy": "degrade-to-pending-depth-diagnostics-without-changing-gameplay",
      "resourceClass": "pvp-network-support",
      "requiredTests": ["net-governor-audit", "audit:pvp-facing", "audit:performance"]
    },
    {
      "id": "pvp-auto-reducer",
      "owner": "KeloPvPAutoReducer",
      "source": "src/systems/pvp-auto-reducer.js",
      "technicalDoc": "docs/systems/PVP_AUTO_REDUCER.md",
      "apiVersion": 2,
      "authority": "client-presentation-quality-only",
      "stateOwned": ["network-quality baseline/EMA/jitter", "warning/reduction/recovery episode", "saved presentation quality"],
      "stateForbidden": ["damage", "HP", "cooldowns", "hitboxes", "server tick", "MMR/RP", "match result", "transport ownership"],
      "consumes": ["KeloSimulation", "KeloNetAuthority.getPvpNetworkHealth", "KELO_PERF", "KeloPvPWorld"],
      "lifecycle": ["monitor", "warn", "degrade", "recover", "restore", "disable"],
      "failurePolicy": "degrade-presentation-only-never-gameplay-truth",
      "resourceClass": "pvp-optional-support",
      "requiredTests": ["pvp-auto-reducer-audit", "net-governor-audit", "audit:pvp-facing", "audit:performance"]
    },
    {
      "id": "creator-exclusive-runtime",
      "owner": "Kelo Creators + Foundation owners",
      "source": "src/creators/core/creator-exclusive-runtime.mjs",
      "technicalDoc": "docs/systems/CREATOR_EXCLUSIVE_RUNTIME.md",
      "apiVersion": 1,
      "authority": "creator-local-lifecycle",
      "stateOwned": ["creator-exclusive claims", "Foundation resource tokens"],
      "stateForbidden": ["gameplay state", "online authority", "asset publication"],
      "consumes": ["KeloInputLocks", "KeloMovement", "KeloSimulation", "KeloRender", "KELO_ATLAS_CONTRACT", "KeloEvents"],
      "lifecycle": ["enter", "leave", "releaseOwner", "snapshot"],
      "failurePolicy": "cleanup-and-return-to-game",
      "resourceClass": "creator-heavy",
      "requiredTests": ["audit:creator-suite", "recovery:world"]
    },
    {
      "id": "app-updater",
      "owner": "KeloUpdater",
      "source": "src/core/update-system.js",
      "technicalDoc": "docs/systems/APP_UPDATE_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-update-lifecycle",
      "stateOwned": ["update availability", "download/apply lifecycle"],
      "stateForbidden": ["gameplay state", "auth authority"],
      "consumes": ["service worker", "network state"],
      "lifecycle": ["check", "prepare", "apply-at-safe-boundary", "snapshot"],
      "failurePolicy": "continue-current-known-good-build",
      "resourceClass": "background",
      "requiredTests": ["audit:updater"]
    },
    {
      "id": "online-foundation",
      "owner": "Kelo server authority + Supabase persistence",
      "source": "server/online-identity-store.js",
      "technicalDoc": "docs/systems/ONLINE_FOUNDATION.md",
      "apiVersion": 1,
      "authority": "server-authoritative",
      "stateOwned": ["online identity validation", "durable authoritative persistence boundaries"],
      "stateForbidden": ["browser-trusted final economic result", "browser-trusted final combat result"],
      "consumes": ["Supabase Auth", "Supabase RLS", "server state bridge", "KeloNetAuthority transport"],
      "lifecycle": ["authenticate", "hydrate", "mutate-authoritatively", "flush", "audit"],
      "failurePolicy": "fail-closed-for-valued-or-competitive-operations",
      "resourceClass": "server-critical",
      "requiredTests": ["audit:online-foundation"]
    },
    {
      "id": "commerce",
      "owner": "KeloCommerceAuthority",
      "source": "src/systems/commerce-authority.js",
      "technicalDoc": "docs/systems/COMMERCE_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-fallback-server-required-for-shared-value",
      "stateOwned": ["commerce client/domain flow"],
      "stateForbidden": ["trusted final wallet balance", "trusted final market settlement"],
      "consumes": ["PlayerEconomyStore", "online authority bridge"],
      "lifecycle": ["request", "validate", "settle-authoritatively", "receipt"],
      "failurePolicy": "fail-closed-for-shared-settlement",
      "resourceClass": "domain",
      "requiredTests": ["audit:commerce", "audit:online-foundation"]
    },
    {
      "id": "arena-ranked",
      "owner": "KeloArena",
      "source": "src/systems/arena-system.js",
      "technicalDoc": "docs/systems/ARENA_SYSTEM.md",
      "apiVersion": 1,
      "authority": "client-fallback-server-authority-pending",
      "stateOwned": ["local queue/match fallback", "ruleset orchestration", "arena objectives presentation/fallback"],
      "stateForbidden": ["trusted final ranked result", "trusted final MMR/RP", "combat hit/damage ownership"],
      "consumes": ["KeloPvPWorld", "KeloCombatEngine", "KeloSimulation", "KeloNetAuthority"],
      "lifecycle": ["queue", "enter", "active", "finish", "restore", "leave"],
      "failurePolicy": "degrade-to-practice-unranked-when-server-authority-unavailable",
      "resourceClass": "domain-critical",
      "requiredTests": ["audit:arena", "audit:pvp-facing"]
    },
    {
      "id": "guardian-network",
      "owner": "KeloGuardian + Kelo Guardian Coordinator",
      "source": "src/systems/guardian-system.js",
      "technicalDoc": "docs/systems/GUARDIAN_SYSTEM.md",
      "apiVersion": 1,
      "authority": "untrusted-community-capacity-with-trusted-coordination",
      "stateOwned": ["guardian client preference/capability state", "coordinator leases/proofs"],
      "stateForbidden": ["direct KC mint", "direct economic settlement", "direct PvP authority without explicit migration"],
      "consumes": ["Supabase control plane", "WebRTC", "KeloSimulation", "server coordinator"],
      "lifecycle": ["activate", "heartbeat", "lease", "connect", "release", "expire"],
      "failurePolicy": "degrade-to-central-authority-path",
      "resourceClass": "optional-distributed",
      "requiredTests": ["audit:guardian"]
    },
    {
      "id": "kelo-evolution",
      "owner": "KeloEvolution",
      "source": "src/creators/evolution/evolution-engine.mjs",
      "technicalDoc": "docs/systems/KELO_EVOLUTION_ENGINE.md",
      "apiVersion": 1,
      "authority": "proposal-and-independent-evaluation-only",
      "stateOwned": ["immutable evaluation reports returned to callers"],
      "stateForbidden": ["Git merge", "deploy", "production authority", "self-assigned objective score"],
      "consumes": ["problem evidence", "bounded snapshots", "external agent callback", "independent evaluator callback"],
      "lifecycle": ["propose", "validate", "sandbox", "evaluate", "holdout", "return-candidate"],
      "failurePolicy": "fail-closed-no-candidate-promotion",
      "resourceClass": "build-internal",
      "requiredTests": ["audit:evolution", "audit:evolution:sandbox"]
    }
  ]
}
