# Public project URL; safe to expose to the browser.
SUPABASE_URL=https://iapxdbitjdwvtbpjghct.supabase.co

# Browser only: use an sb_publishable_* key from Supabase API Keys.
SUPABASE_PUBLISHABLE_KEY=

# Server only. Prefer the modern sb_secret_* key.
# NEVER put this in browser code, GitHub Pages or localStorage.
SUPABASE_SECRET_KEY=

# Temporary compatibility for existing server stores while they are migrated
# from the legacy service-role credential model.
SUPABASE_SERVICE_ROLE_KEY=

# 0 = legacy/local hello still accepted during migration.
# 1 = WebSocket connections must present a verified Supabase session + owned character.
KELO_REQUIRE_AUTH=0

# Sprite AI server provider. `auto` prefers the free Hugging Face/ZeroGPU
# bridge when KELO_SPRITE_AI_HF_SPACE is configured, otherwise it may use
# OpenAI only when OPENAI_API_KEY is explicitly present.
KELO_SPRITE_AI_PROVIDER=auto
KELO_SPRITE_AI_HF_SPACE=
KELO_SPRITE_AI_HF_API_NAME=/generate
KELO_SPRITE_AI_HF_V3_API_NAME=/generate_v3
KELO_SPRITE_AI_TIMEOUT_MS=180000

# Dedicated real-skeleton backend. Keep disabled globally until an actual
# ZeroGPU Space passes end-to-end inference and Frame Doctor QA.
KELO_SPRITE_AI_HF_POSE_SPACE=
KELO_SPRITE_AI_HF_POSE_API_NAME=/generate_pose
KELO_SPRITE_AI_POSE_TIMEOUT_MS=240000
KELO_SPRITE_AI_REAL_SKELETON=0

# Default remains V2 until the deployed Spaces have passed real V3 inference QA.
# The same /api/sprite-generate endpoint accepts pipeline=identity-skeleton-v3
# per request, so V3 can be exercised safely without breaking existing clients.
KELO_SPRITE_AI_PIPELINE=atlas-v2
KELO_SPRITE_AI_ENABLE_MASTER_CHARACTER=1
KELO_SPRITE_AI_ENABLE_DIRECTIONAL_GENERATION=1
KELO_SPRITE_AI_ENABLE_SELECTIVE_REPAIR=1
KELO_SPRITE_AI_ENABLE_ROTATION_STAGE=1

# Server-only Hugging Face token. Optional for public Spaces, useful so calls
# use the connected account's ZeroGPU quota. NEVER expose in GitHub Pages.
HF_TOKEN=

# Safety default: a failed/exhausted free provider MUST NOT silently use a
# paid provider. Set to 1 only when paid fallback is deliberately approved.
KELO_SPRITE_AI_ALLOW_PAID_FALLBACK=0

# Optional paid provider. Keep empty when operating free-only.
OPENAI_API_KEY=
KELO_SPRITE_AI_MODEL=gpt-image-2.5-sunburst
KELO_SPRITE_AI_QUALITY=low
KELO_SPRITE_AI_SIZE=1024x2048
