{
  "version": 3,
  "defaultMode": "LEGACY",
  "allowedModes": ["LEGACY", "SHADOW", "NEW"],
  "domains": {
    "input": {
      "mode": "LEGACY",
      "owner": "InputSystem",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["processInput"],
      "activationGate": "characterization-pass"
    },
    "movement": {
      "mode": "LEGACY",
      "owner": "MovementSystem",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["localPlayer.x", "localPlayer.y", "updateMovement"],
      "activationGate": "shadow-parity"
    },
    "camera": {
      "mode": "LEGACY",
      "owner": "KeloCamera",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["cameraX", "cameraY"],
      "activationGate": "shadow-parity"
    },
    "cameraFollow": {
      "mode": "SHADOW",
      "owner": "KeloCameraFollowShadow",
      "legacy": ["engine-a.js"],
      "contracts": ["camera.lookOffsetX", "camera.lookOffsetY", "camera.targetX", "camera.targetY", "camera.x", "camera.y"],
      "activationGate": "runtime-shadow-parity",
      "authority": "legacy-only",
      "shadowEvidence": "KELO_CAMERA_FOLLOW_SHADOW_AUDIT"
    },
    "playerState": {
      "mode": "LEGACY",
      "owner": "PlayerState",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["localPlayer.hp", "localPlayer.maxHp"],
      "activationGate": "single-writer"
    },
    "collision": {
      "mode": "LEGACY",
      "owner": "KELO_COLLISION",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["obstacles"],
      "activationGate": "single-writer"
    },
    "render": {
      "mode": "LEGACY",
      "owner": "KeloRender",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["render", "renderAvatar"],
      "activationGate": "visual-parity"
    },
    "simulation": {
      "mode": "LEGACY",
      "owner": "SimulationSystem",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["updateSimulation"],
      "activationGate": "shadow-parity"
    },
    "simulationFarmTick": {
      "mode": "SHADOW",
      "owner": "SimulationFarmShadow",
      "legacy": ["engine-c.js"],
      "contracts": ["STATE.farm.coop.ready", "STATE.silo.eggs", "STATE.farm.pen.ready", "STATE.silo.pork"],
      "activationGate": "shadow-parity",
      "authority": "legacy-only",
      "shadowEvidence": "KELO_SIMULATION_FARM_SHADOW_AUDIT"
    },
    "world": {
      "mode": "LEGACY",
      "owner": "WorldSystem",
      "legacy": ["engine-a.js", "engine-c.js"],
      "contracts": ["worldMap"],
      "activationGate": "world-load-baseline"
    }
  }
}
