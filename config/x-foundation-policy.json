      "browserPolicy": "capability-gated"
    },
    "pvp-auto-reducer": {
      "dependsOnSystems": ["performance-foundation", "simulation-extensions"],
      "failureMode": "fail-open-presentation",
      "blastRadius": "pvp-presentation-quality-only",
      "killSwitchPolicy": "feature-registry",
      "browserPolicy": "capability-gated"
    },
    "creator-exclusive-runtime": {
      "dependsOnSystems": ["input-locks", "movement", "simulation-extensions", "render-extensions"],
      "failureMode": "degrade",
      "blastRadius": "creator-session-only",
      "killSwitchPolicy": "feature-registry",
      "browserPolicy": "capability-gated"
    },
    "app-updater": {
      "dependsOnSystems": [],
      "failureMode": "degrade",
      "blastRadius": "update-delivery-only",
      "killSwitchPolicy": "admin-config",
      "browserPolicy": "capability-gated"
    },
    "online-foundation": {
      "dependsOnSystems": [],
      "failureMode": "fail-closed",
      "blastRadius": "shared-online-authority",
      "killSwitchPolicy": "server-authority",
      "browserPolicy": "server-only"
    },
    "commerce": {
      "dependsOnSystems": ["online-foundation"],
      "failureMode": "fail-closed",
      "blastRadius": "commerce-settlement-only",
      "killSwitchPolicy": "server-authority",
      "browserPolicy": "capability-gated"
    },
    "arena-ranked": {
      "dependsOnSystems": ["simulation-extensions", "online-foundation"],
      "failureMode": "local-practice",
      "blastRadius": "ranked-arena-only",
      "killSwitchPolicy": "feature-registry",
      "browserPolicy": "capability-gated"
    },
    "guardian-network": {
      "dependsOnSystems": ["simulation-extensions", "online-foundation"],
      "failureMode": "degrade",
      "blastRadius": "distributed-capacity-only",
      "killSwitchPolicy": "feature-registry",
      "browserPolicy": "capability-gated"
    },
    "kelo-evolution": {
      "dependsOnSystems": [],
      "failureMode": "fail-closed",
      "blastRadius": "candidate-generation-only",
      "killSwitchPolicy": "pr-only",
      "browserPolicy": "build-time"
    }
  },
  "forbiddenNewCodePatterns": [
    {
      "id": "parallel-game-loop",
      "paths": ["src/core/", "src/systems/"],
      "pattern": "requestAnimationFrame\\s*\\(",
      "allowPaths": ["src/core/render-extension-system.js"]
    },
    {
      "id": "state-repair-interval",
      "paths": ["src/core/", "src/systems/"],
      "pattern": "setInterval\\s*\\(",
      "allowPaths": []
    },
    {
      "id": "direct-obstacle-push",
      "paths": ["src/"],
      "pattern": "\\bobstacles\\.push\\s*\\(",
      "allowPaths": []
    }
  ]
}
