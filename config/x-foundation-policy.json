{
  "schema": 1,
  "failureModes": ["fail-closed", "degrade", "retry-later", "local-practice", "fail-open-presentation"],
  "browserPolicies": ["critical-baseline", "capability-gated", "server-only", "build-time"],
  "killSwitchPolicies": ["none-core", "feature-registry", "server-authority", "admin-config", "pr-only"],
  "systems": {
    "input-locks": {
      "dependsOnSystems": [],
      "failureMode": "fail-closed",
      "blastRadius": "input-only",
      "killSwitchPolicy": "none-core",
      "browserPolicy": "critical-baseline"
    },
    "movement": {
      "dependsOnSystems": ["input"],
      "failureMode": "degrade",
      "blastRadius": "movement-extension-only",
      "killSwitchPolicy": "none-core",
      "browserPolicy": "critical-baseline"
    },
    "camera": {
      "dependsOnSystems": [],
      "failureMode": "degrade",
      "blastRadius": "presentation-only",
      "killSwitchPolicy": "none-core",
      "browserPolicy": "critical-baseline"
    },
    "render-extensions": {
      "dependsOnSystems": [],
      "failureMode": "fail-open-presentation",
      "blastRadius": "presentation-only",
      "killSwitchPolicy": "none-core",
      "browserPolicy": "critical-baseline"
    },
    "simulation-extensions": {
      "dependsOnSystems": [],
      "failureMode": "degrade",
      "blastRadius": "client-simulation-extension-only",
      "killSwitchPolicy": "none-core",
      "browserPolicy": "critical-baseline"
    },
    "performance-foundation": {
      "dependsOnSystems": ["simulation-extensions", "render-extensions"],
